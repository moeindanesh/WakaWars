DATABASE_URL="postgresql://user:password@localhost:5432/wakawars"
PORT=3000

# OpenRouter (AI honor titles). Leave OPENROUTER_API_KEY unset to fall back to
# the deterministic honor titles. OPENROUTER_MODEL is optional and overrides the
# default cheap model.
OPENROUTER_API_KEY=""
OPENROUTER_MODEL=""

# Days to retain ww_provider_log rows before the daily cleanup deletes them.
PROVIDER_LOG_RETENTION_DAYS=14
